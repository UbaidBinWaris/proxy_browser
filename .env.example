# Proxy QA Browser — DEVELOPMENT-ONLY environment configuration
# Copy this file to `.env` and fill in your own credentials for `npm run dev`.
# `.env` is git-ignored. Never commit real credentials.
#
# Packaged builds (AppImage, Windows portable EXE) NEVER read a .env file:
# credentials are entered in the first-run setup and stored in the encrypted
# per-machine vault (see README → "Credential vault"). Credentials saved in
# the vault also take precedence over this file in development.
#
# Where the development app looks for `.env` (first match wins):
#   1. next to the Electron executable (node_modules/electron/dist)
#   2. the project directory
#   3. the app data folder (<userData>/.env)

# DataImpulse residential proxy gateway
DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
DATAIMPULSE_PROXY_PORT=823
DATAIMPULSE_PROXY_USERNAME=your_username_here
DATAIMPULSE_PROXY_PASSWORD=your_password_here

# Optional: sticky-session username template. Placeholders: {username} {session} {sep}
# Default follows the DataImpulse docs: {username}{sep}sessid.{session}
# DATAIMPULSE_SESSION_TEMPLATE={username}{sep}sessid.{session}

# Optional: override where Playwright browsers are provisioned.
# Defaults to <userData>/data/browsers in the packaged app and to Playwright's
# cache (~/.cache/ms-playwright) in development.
# PLAYWRIGHT_BROWSERS_PATH=

# Optional: default test form URL on first launch (can be changed in Settings).
# PROXY_QA_DEFAULT_FORM_URL=https://example.com/
