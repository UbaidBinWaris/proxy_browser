<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Developer ID builds (scripts/mac-signing.mjs uses this file for the
  app and, inherited, for its Electron helpers). Ad-hoc dev builds run without the hardened runtime.

  allow-jit                         V8 compiles JavaScript at run time (required for Electron on arm64).
  allow-unsigned-executable-memory  V8/WebAssembly pages that are not covered by a code signature.
  network.client                    outbound connections (proxy checks, update feed, browser downloads);
                                    only enforced inside the App Sandbox, kept for an explicit record.

  Playwright's Chromium/Firefox/WebKit builds are separate executables downloaded into the app data
  folder and started as child processes; they carry their own signatures and need nothing from here.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
