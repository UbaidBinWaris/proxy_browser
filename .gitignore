# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies & build output
node_modules/
out/
dist/
release/
release-update-smoke/
*.tsbuildinfo

# Self-contained build inputs (scripts/bundle-browsers.mjs): ~1 GB of Playwright
# browsers per platform and the Ubuntu WebKit host libraries
build/browsers/
build/webkit-libs/

# Runtime data (SQLite, screenshots, logs, provisioned browsers)
data/
!data/.gitkeep
!data/screenshots/.gitkeep

# Editor / OS / agent tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.remember/
.serena/
.claude/settings.local.json
.claude/worktrees/

# Windows smoke test output (scripts/windows-smoke.cjs)
smoke-output/
qa-results/
*.pqab
*.pfx
*.p12
*.pem
.release-keys/
!resources/updates/public-key.pem

# Download website and deployment inputs
app/webapp/.next/
app/webapp/node_modules/
# Generated by scripts/sync-docs.mjs from docs/site, resources/release-notes.json and NOTICE
app/webapp/content/
app/webapp/public/docs-assets/
app/webapp/.env*
!app/webapp/.env.example
!app/webapp/public-key.pem
.deploy/
server-data/
