# Never commit real credentials. All variables below are server-only.
SITE_URL=https://proxybrowser.ubaidbinwaris.com
RELEASE_ROOT=/var/lib/proxy-browser
RELEASE_PUBLIC_KEY_FILE=/opt/proxy-browser/current/public-key.pem
# Generate a unique random token: openssl rand -hex 32
ADMIN_TOKEN=
PORT=4500
HOSTNAME=127.0.0.1
